---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNovels, getChapters } from '../lib/novels';

const novels = getNovels();
const novelData = novels.map((novel) => ({
  ...novel,
  chapterCount: getChapters(novel.slug).length,
}));
---

<BaseLayout title="Kidung � Rumah Baca Novel" description="Platform baca novel gelap dan kontemporer.">
  <main class="page">
    <header class="site-header">
      <a href="/" class="brand">
        <span>Kidung</span>
        <span class="brand-subtitle">Rumah baca novel</span>
      </a>
      <nav class="site-nav">
        <a href="/" class="button button-ghost">Home</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero-inner">
        <span class="hero-label">Kidung</span>
        <h1 class="hero-title">Rumah Cerita &amp; Novel</h1>
        <p class="hero-text">Baca novel gelap, urban fantasy, dan cerita kontemporer. Desain sederhana, fokus membaca.</p>
        <div class="hero-actions">
          <a href="#novels" class="button button-primary">Mulai Baca</a>
          <a href="/novel/gods-in-jars" class="button button-ghost">Baca Gratis</a>
        </div>
      </div>
    </section>

    <section class="section" id="novels">
      <h2 class="section-title">Novel Tersedia</h2>
      <p class="section-text">Pilih novel, buka chapter pertama, dan lanjutkan saat kamu siap.</p>

      {novelData.length === 0 ? (
        <p class="meta">Belum ada novel tersedia.</p>
      ) : (
        <div class="novel-grid">
          {novelData.map((novel) => (
            <a href={`/novel/${novel.slug}`} class="novel-card">
              <div class="novel-cover">
                {novel.cover ? (
                  <img src={novel.cover} alt={`Cover ${novel.title}`} loading="lazy" />
                ) : (
                  <div class="novel-cover-placeholder">
                    <span class="cover-glyph">📚</span>
                    <span>Cover akan menyusul</span>
                  </div>
                )}
              </div>
              <div class="novel-card-body">
                <div class="card-title">{novel.title}</div>
                <div class="novel-card-meta">
                  <span class="pill">{novel.chapterCount} chapter</span>
                  <span class="meta">{novel.genre || 'Novel'}</span>
                </div>
                <p class="novel-card-desc">{novel.description || 'Sinopsis belum tersedia.'}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <section class="section section-grid">
      <div class="card">
        <div class="card-title">Fokus membaca</div>
        <p class="card-text">Desain gelap dan sederhana membantu menjaga konsentrasi saat membaca cerita panjang.</p>
      </div>
      <div class="card">
        <div class="card-title">Navigasi lancar</div>
        <p class="card-text">Daftar chapter tersusun rapi agar kamu bisa langsung lompat ke bagian selanjutnya.</p>
      </div>
    </section>

    <footer class="footer">
      <p>© {new Date().getFullYear()} Kidung — Desain sederhana untuk pembaca novel.</p>
    </footer>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.novel-history').forEach((node) => {
          const slug = node.dataset.slug;
          const saved = localStorage.getItem('kidung-reading-history-' + slug);
          if (!saved) return;
          try {
            const history = JSON.parse(saved);
            node.textContent = `Terakhir: ${history.chapterTitle} — ${history.sectionTitle}`;
          } catch (error) {
            // ignore invalid local storage
          }
        });
      });
    </script>
  </main>
</BaseLayout>
