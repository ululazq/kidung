---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNovels, getChapters } from '../../lib/novels';

export function getStaticPaths() {
  return getNovels().map((novel) => ({ params: { slug: novel.slug } }));
}

const { slug } = Astro.params;
const novel = getNovels().find((n) => n.slug === slug);
if (!novel) return Astro.redirect('/404');

const chapters = getChapters(slug);
const totalWords = chapters.reduce((sum, chapter) => sum + chapter.wordCount, 0);
---

<BaseLayout title={`${novel.title} � Kidung`} description={novel.description || 'Halaman novel di Kidung.'}>
  <main class="page">
    <header class="site-header">
      <a href="/" class="brand">Kidung</a>
      <nav class="site-nav">
        <a href="/" class="button button-ghost">Home</a>
        {chapters.length > 0 && <a href={`/chapter/${chapters[0].slug}`} class="button button-primary">Baca</a>}
      </nav>
    </header>

    <section class="section">
      <span class="hero-label">{novel.genre || 'Novel'}</span>
      <h1 class="section-title">{novel.title}</h1>
      <p class="section-text">{novel.description || 'Belum ada sinopsis untuk novel ini.'}</p>
    </section>

    <div class="history-banner" id="novelHistory">
      Memuat riwayat baca novel...
    </div>

    <section class="section cards">
      <div class="card">
        <div class="card-title">Detail</div>
        <p class="card-text">{chapters.length} chapter � {totalWords.toLocaleString()} kata</p>
      </div>
      <div class="card">
        <div class="card-title">Mulai</div>
        {chapters.length > 0 ? (
          <a href={`/chapter/${chapters[0].slug}`} class="button button-primary">Chapter pertama</a>
        ) : (
          <p class="card-text">Belum ada chapter tersedia.</p>
        )}
      </div>
    </section>

    <section class="section">
      <span class="meta">Daftar Chapter</span>
      <h2 class="section-title">Urutan bacaan</h2>
      {chapters.length === 0 ? (
        <p class="meta">Belum ada chapter yang terbit.</p>
      ) : (
        <div class="chapter-list">
          {chapters.map((chap) => (
            <a href={`/chapter/${chap.slug}`} class="chapter-link">
              <div class="card-title">{`Chapter ${chap.number}: ${chap.title}`}</div>
              <p class="card-text">{chap.wordCount.toLocaleString()} kata</p>
            </a>
          ))}
        </div>
      )}
    </section>
    <div id="novelMeta" data-novel-history-key={`kidung-reading-history-${slug}`} hidden></div>
    <script>
      const novelMeta = document.getElementById('novelMeta');
      const novelHistoryKey = novelMeta?.dataset?.novelHistoryKey || '';
      const historyBanner = document.getElementById('novelHistory');
      const savedHistory = localStorage.getItem(novelHistoryKey);
      if (!savedHistory) {
        historyBanner.textContent = 'Belum ada riwayat baca untuk novel ini.';
      } else {
        try {
          const history = JSON.parse(savedHistory);
          const chapterUrl = history.chapterSlug ? `/chapter/${history.chapterSlug}` : '#';
          historyBanner.innerHTML = `Terakhir dibaca: <strong>${history.chapterTitle}</strong> pada <em>${history.sectionTitle}</em>. <a href="${chapterUrl}" class="button button-ghost">Lanjutkan</a>`;
        } catch (error) {
          historyBanner.textContent = 'Belum ada riwayat baca untuk novel ini.';
        }
      }
    </script>
  </main>
</BaseLayout>
