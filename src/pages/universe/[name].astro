---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getUniverse, getUniverseSummaries, readingMinutes, type Novel } from '../../lib/novels'
import { buildUniverseNetwork } from '../../lib/network'

export async function getStaticPaths() {
  const universes = await getUniverseSummaries()
  return universes.map((u) => ({ params: { name: u.slug } }))
}

const { name } = Astro.params

const universe = await getUniverse(name!)
if (!universe) return Astro.redirect('/404')

// Per-universe visual flavor for the timeline nodes; falls back to genre/Buku N.
const LAYER_BY_SLUG: Record<string, string> = {
  'the-unbound': 'Skyreach',
  bloodfall: 'Heartland',
  'the-deep-vow': 'Underreach',
  'the-rejoining': 'Konvergensi',
}

// Novel paralel: diumumkan lewat frontmatter `parallel` di README tiap novel
// (mis. sang-penjalin ↔ pangkal — peristiwa yang sama diceritakan dari dua sisi,
// boleh dibaca dari urutan mana pun). Penanda di bawah memakai data itu langsung,
// jadi menambah pasangan baru cukup lewat frontmatter.
const isParallel = (novel: Novel): boolean => (novel.parallel?.length ?? 0) > 0

/** Judul pasangan paralel pertama (fallback ke slug). */
const parallelPartnerTitle = (slug: string): string => {
  const partner = universe.series.find((n) => n.slug === slug)?.parallel?.[0]
  return universe.series.find((n) => n.slug === partner)?.title ?? partner ?? ''
}

// Ringkasan pasangan paralel serial ini, mis. "Buku 4 & 5 (Sang Penjalin & Pangkal)".
const parallelSummary = (() => {
  const pair = universe.series.filter((n) => isParallel(n))
  if (pair.length < 2) return null
  return {
    label: `Buku ${pair.map((n) => n.order).join(' & ')}`,
    titles: pair.map((n) => n.title).join(' & '),
  }
})()

const totalChapters = universe.series.reduce((sum, n) => sum + n.chapterCount, 0)
const totalWords = universe.series.reduce((sum, n) => sum + n.totalWords, 0)
const startHref = universe.series[0]
  ? `/chapter/${universe.series[0].slug}/chapter-1`
  : null

// --- Peta jaringan: novel sebagai node, istilah bersama sebagai edge ---
const network = await buildUniverseNetwork(universe.title)

// Layout melingkar: hitung posisi node secara deterministik.
const NET_W = 760
const NET_H = 620
const NET_CX = NET_W / 2
const NET_CY = NET_H / 2
const NET_R = Math.min(270, Math.max(150, 90 + network.nodes.length * 4))
// Radius node proporsional terhadap jumlah koneksi (dipakai juga untuk legenda).
const nodeRadius = (degree: number) => Math.min(26, 10 + degree * 0.7)
const netPos = new Map<string, { x: number; y: number }>()
network.nodes.forEach((node, i) => {
  const angle = (i / Math.max(1, network.nodes.length)) * Math.PI * 2 - Math.PI / 2
  netPos.set(node.slug, {
    x: NET_CX + NET_R * Math.cos(angle),
    y: NET_CY + NET_R * Math.sin(angle),
  })
})

const netTermNotes = new Map(network.terms.map((t) => [t.term, t.note]))
---

<BaseLayout title={`${universe.title} · Universe`} description={universe.description}>
  <div class="container">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">Beranda</a>
      <span aria-hidden="true">/</span>
      <a href="/universe">Universe</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{universe.title}</span>
    </nav>

    <header class="universe-hero">
      <h1>{universe.title}</h1>
      <div class="badges">
        <span class="badge badge-universe">{universe.status}</span>
        <span class="badge">{universe.genre}</span>
        <span class="badge">
          {universe.series.length} {universe.series.length === 1 ? 'novel' : 'novel'}
        </span>
        <span class="badge">
          {totalChapters} bab · {totalWords.toLocaleString('id-ID')} kata
        </span>
      </div>
    </header>

    {universe.description && (
      <p class="universe-desc">{universe.description}</p>
    )}

    {universe.series.length > 0 ? (
      <section class="series-section">
        <div class="section-head">
          <div>
            <h2>Serial — Urutan Baca</h2>
            {parallelSummary && (
              <p class="muted parallel-hint">
                {parallelSummary.label} ({parallelSummary.titles}) berjalan{' '}
                <strong>paralel</strong> — peristiwa yang sama diceritakan dari dua
                sisi, boleh dibaca dari sisi mana pun.
              </p>
            )}
          </div>
          {startHref && (
            <a href={startHref} class="btn btn-primary">Mulai dari Awal →</a>
          )}
        </div>

        <div class="timeline-track" id="timeline-track" aria-label="Timeline urutan baca serial">
          {universe.series.map((novel, i) => (
            <button
              class={`tl-node${isParallel(novel) ? ' tl-node-parallel' : ''}`}
              data-index={i}
              aria-pressed={i === 0}
              aria-label={`Lompat ke ${novel.title}${isParallel(novel) ? ' — novel paralel' : ''}`}
            >
              <span class="tl-dot">{novel.order}</span>
              <span class="tl-title">{novel.title}</span>
              <span class="tl-tag">
                {LAYER_BY_SLUG[novel.slug] ?? novel.genreTags[0] ?? `Buku ${novel.order}`}
              </span>
              {isParallel(novel) && (
                <span class="tl-parallel">Paralel</span>
              )}
            </button>
          ))}
        </div>

        <div class="timeline-detail" id="timeline-detail">
          {universe.series.map((novel, i) => {
            const minutes = readingMinutes(novel.totalWords)
            const firstParagraph =
              novel.description.split(/\n+/)[0]?.trim() || novel.description
            const coverUrl = novel.cover ? `/covers/${novel.cover}` : null
            return (
              <article class="tl-card" id={`tl-card-${i}`} data-index={i} tabindex="-1">
                <div class="tl-card-grid">
                  {coverUrl && (
                    <img
                      src={coverUrl}
                      alt={`Cover ${novel.title}`}
                      class="tl-cover"
                      loading="lazy"
                    />
                  )}
                  <div class="tl-card-body">
                    <div class="tl-card-head">
                      <span class="tl-booknum">Buku {novel.order}</span>
                      <span
                        class={`badge ${novel.status === 'Complete' ? 'badge-complete' : 'badge-progress'}`}
                      >
                        <span class="badge-dot" aria-hidden="true"></span>
                        {novel.status}
                      </span>
                    </div>
                    {isParallel(novel) && (
                      <p class="tl-parallel-note">
                        <strong>Novel paralel</strong> — peristiwa yang sama diceritakan
                        dari sisi lain di <strong>{parallelPartnerTitle(novel.slug)}</strong>.
                        Bisa dibaca dari sisi mana pun.
                      </p>
                    )}
                    <h3>{novel.title}</h3>
                    <p class="tl-synopsis">{firstParagraph}</p>
                    <p class="tl-stats">
                      {novel.chapterCount} bab · {novel.totalWords.toLocaleString('id-ID')} kata ·
                      ~{minutes} menit baca
                    </p>
                    <div class="tl-actions">
                      <a href={`/chapter/${novel.slug}/chapter-1`} class="btn btn-primary">
                        Mulai Baca
                      </a>
                      <a href={`/novel/${novel.slug}`} class="btn">Lihat Novel</a>
                    </div>
                  </div>
                </div>
              </article>
            )
          })}
        </div>
      </section>
    ) : (
      <p class="universe-desc">Belum ada novel terdaftar untuk universe ini.</p>
    )}

    {network.nodes.length >= 2 && network.edges.length > 0 && (
      <section class="network-section" aria-labelledby="network-title">
        <div class="section-head">
          <div>
            <h2 id="network-title">Peta Jaringan Novel</h2>
            <p class="muted">
              Novel yang berbagi istilah multiverse terhubung — arahkan ke node
              untuk melihat koneksinya, klik untuk membuka novel.
            </p>
          </div>
        </div>

        <div class="network-layout">
          <svg
            id="network-svg"
            class="network-svg"
            viewBox={`0 0 ${NET_W} ${NET_H}`}
            role="img"
            aria-label={`Peta jaringan ${universe.title}: ${network.nodes.length} novel dihubungkan oleh istilah multiverse bersama`}
          >
            {/* Edge: dua novel yang berbagi istilah */}
            {network.edges.map((e) => {
              const pa = netPos.get(e.a)!
              const pb = netPos.get(e.b)!
              const shared = e.terms.join(', ')
              return (
                <line
                  class="net-edge"
                  x1={pa.x}
                  y1={pa.y}
                  x2={pb.x}
                  y2={pb.y}
                  data-a={e.a}
                  data-b={e.b}
                  data-terms={shared}
                >
                  <title>{`${e.terms.length} istilah bersama: ${shared}`}</title>
                </line>
              )
            })}

            {/* Node: novel */}
            {network.nodes.map((node) => {
              const p = netPos.get(node.slug)!
              const radius = nodeRadius(node.degree)
              const label = node.title
              const labelY = p.y + 4
              // Posisikan label ke kiri bila node di sisi kanan lingkaran
              const anchor = p.x > NET_CX ? 'start' : 'end'
              const lx = p.x > NET_CX ? p.x + radius + 8 : p.x - radius - 8
              return (
                <g
                  class="net-node"
                  data-slug={node.slug}
                  tabindex="0"
                  role="link"
                  aria-label={`${node.title} — ${node.degree} koneksi`}
                >
                  <title>{`${node.title} — ${node.terms.length} istilah khas, ${node.degree} koneksi`}</title>
                  <circle
                    class="net-node-circle"
                    cx={p.x}
                    cy={p.y}
                    r={radius}
                  />
                  <text
                    class="net-node-label"
                    x={lx}
                    y={labelY}
                    text-anchor={anchor}
                  >
                    {label}
                  </text>
                </g>
              )
            })}
          </svg>

          <aside class="network-panel" id="network-panel" aria-live="polite">
            <p class="panel-hint" id="network-panel-default">
              Arahkan kursor (atau fokus) ke sebuah novel untuk melihat
              istilah yang dibaginya dengan novel lain.
            </p>
          </aside>
        </div>

        <div class="network-footer">
          {network.terms.length > 0 && (
            <div class="term-filter" role="group" aria-label="Filter peta berdasarkan istilah">
              <span class="term-filter-label">Filter istilah:</span>
              <button class="term-chip active" data-term="all" aria-pressed="true">
                Semua
              </button>
              {network.terms.map((t) => (
                <button
                  class="term-chip"
                  data-term={t.term}
                  aria-pressed="false"
                  title={netTermNotes.get(t.term) ?? t.term}
                >
                  {t.term}
                </button>
              ))}
            </div>
          )}

          <div class="net-legend" aria-label="Legenda peta">
            <span class="legend-item">
              <i class="legend-dot" style="--d: 8px" aria-hidden="true"></i>
              Sedikit koneksi
            </span>
            <span class="legend-item">
              <i class="legend-dot" style="--d: 14px" aria-hidden="true"></i>
              Sedang
            </span>
            <span class="legend-item">
              <i class="legend-dot" style="--d: 22px" aria-hidden="true"></i>
              Banyak koneksi
            </span>
            <span class="legend-item">
              <i class="legend-line" aria-hidden="true"></i>
              Berbagi istilah
            </span>
          </div>
        </div>
      </section>
    )}

    <section class="canon-section">
      <h2>Tentang {universe.title}</h2>
      <div class="prose" set:html={universe.summaryHtml} />
    </section>

    {universe.docs.length > 0 && (
      <section class="canon-docs">
        <h2>Dokumen Kanon</h2>
        <p class="muted">
          Referensi resmi universe — kosmologi, sistem kekuatan, faksi, dan garis waktu.
        </p>
        {universe.docs.map((doc) => (
          <details class="doc-accordion">
            <summary>{doc.name}</summary>
            <div class="prose" set:html={doc.html} />
          </details>
        ))}
      </section>
    )}
  </div>

  <style>
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      margin-bottom: 2rem;
      color: var(--text-muted);
    }

    .breadcrumb a {
      color: var(--accent);
      transition: opacity 200ms ease;
    }

    .breadcrumb a:hover {
      opacity: 0.8;
    }

    .universe-hero {
      margin-bottom: 2.5rem;
    }

    h1 {
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      margin-bottom: 1rem;
      line-height: 1.15;
      color: var(--accent);
      font-family: var(--font-display);
    }

    .badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .badge-universe {
      border-color: color-mix(in srgb, var(--accent) 55%, transparent);
      background: color-mix(in srgb, var(--accent) 14%, transparent);
      color: var(--accent);
      font-weight: 600;
    }

    .universe-desc {
      font-size: 1.125rem;
      line-height: 1.7;
      color: var(--text-muted);
      margin-bottom: 3rem;
      max-width: 62ch;
    }

    .series-section {
      margin-bottom: 4.5rem;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    h2 {
      font-family: var(--font-display);
      font-size: 1.75rem;
      color: var(--text);
    }

    .timeline-track {
      position: relative;
      display: flex;
      gap: 0.25rem;
      overflow-x: auto;
      padding: 0.25rem 0.5rem 1.25rem;
      scrollbar-width: thin;
    }

    .timeline-track::before {
      content: '';
      position: absolute;
      left: 3.5rem;
      right: 3.5rem;
      top: 1.75rem;
      height: 2px;
      background: var(--border-strong);
      z-index: 0;
    }

    .tl-node {
      position: relative;
      z-index: 1;
      flex: 1 0 auto;
      min-width: 8rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem;
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font: inherit;
      text-align: center;
      border-radius: var(--radius);
    }

    .tl-node:hover {
      color: var(--text);
    }

    /* Node paralel: titik putus-putus + pill "Paralel" supaya pasangan
       terlihat sebagai satu kelompok sebelum pembaca memulai. */
    .tl-node-parallel .tl-dot {
      border-style: dashed;
      border-color: color-mix(in srgb, var(--accent) 65%, var(--border-strong));
    }

    .tl-node-parallel:hover .tl-dot,
    .tl-node-parallel[aria-pressed='true'] .tl-dot {
      border-style: solid;
    }

    .tl-parallel {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
      white-space: nowrap;
    }

    .tl-dot {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid var(--border-strong);
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-dim);
      transition: all 220ms ease;
    }

    .tl-node:hover .tl-dot,
    .tl-node[aria-pressed='true'] .tl-dot {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-contrast);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
    }

    .tl-title {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.3;
    }

    .tl-tag {
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--text-dim);
      background: var(--bg-elev);
      border: 1px solid var(--border);
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
      white-space: nowrap;
    }

    .timeline-detail {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-top: 2.5rem;
    }

    .tl-card {
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.75rem;
      scroll-margin-top: 6rem;
      transition: border-color 220ms ease, box-shadow 220ms ease;
    }

    .tl-card.active {
      border-color: var(--accent);
      box-shadow:
        0 0 0 1px color-mix(in srgb, var(--accent) 45%, transparent),
        var(--shadow);
    }

    .tl-card-grid {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 1.75rem;
      align-items: start;
    }

    .tl-cover {
      width: 120px;
      aspect-ratio: 2 / 3;
      object-fit: cover;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .tl-card-head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-bottom: 0.5rem;
    }

    .tl-parallel-note {
      margin: 0 0 0.75rem;
      font-size: 0.875rem;
      line-height: 1.55;
      color: var(--text-muted);
      background: color-mix(in srgb, var(--accent) 8%, transparent);
      border: 1px dashed color-mix(in srgb, var(--accent) 40%, transparent);
      border-radius: var(--radius);
      padding: 0.5rem 0.75rem;
    }

    .tl-parallel-note strong {
      color: var(--accent);
      font-weight: 600;
    }

    .parallel-hint {
      margin-top: 0.4rem;
      font-size: 0.9375rem;
      max-width: 62ch;
    }

    .parallel-hint strong {
      color: var(--accent);
      font-weight: 600;
    }

    .tl-booknum {
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--accent);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-size: 0.8125rem;
    }

    .tl-card h3 {
      font-size: 1.5rem;
      margin-bottom: 0.75rem;
    }

    .tl-synopsis {
      color: var(--text-muted);
      line-height: 1.65;
      margin-bottom: 1rem;
    }

    .tl-stats {
      font-size: 0.875rem;
      color: var(--text-dim);
      margin-bottom: 1.25rem;
    }

    .tl-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .canon-section {
      margin-bottom: 4rem;
    }

    .canon-section h2 {
      margin-bottom: 1.5rem;
    }

    .canon-docs h2 {
      margin-bottom: 0.5rem;
    }

    .canon-docs .muted {
      margin-bottom: 1.5rem;
    }

    .doc-accordion {
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 0.75rem;
      overflow: hidden;
    }

    .doc-accordion summary {
      padding: 1rem 1.25rem;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      transition: background 200ms ease;
    }

    .doc-accordion summary::-webkit-details-marker {
      display: none;
    }

    .doc-accordion summary::after {
      content: '+';
      font-size: 1.25rem;
      color: var(--accent);
      transition: transform 220ms ease;
    }

    .doc-accordion[open] summary::after {
      transform: rotate(45deg);
    }

    .doc-accordion summary:hover {
      background: var(--bg-elev-2);
    }

    .doc-accordion .prose {
      padding: 0 1.5rem 1.5rem;
      border-top: 1px solid var(--border);
      font-family: var(--font-reading);
      font-size: 1rem;
      line-height: 1.75;
      color: var(--text);
    }

    .prose :global(p) {
      margin-bottom: 1.5em;
    }

    .prose :global(h2),
    .prose :global(h3) {
      font-family: var(--font-display);
      margin-top: 2em;
      margin-bottom: 0.9em;
      color: var(--accent);
    }

    .prose :global(h2) {
      font-size: 1.5em;
    }

    .prose :global(h3) {
      font-size: 1.25em;
    }

    .prose :global(em) {
      font-style: italic;
      color: var(--text-muted);
    }

    .prose :global(strong) {
      font-weight: 600;
      color: var(--text);
    }

    .prose :global(blockquote) {
      margin: 2em 0;
      padding-left: 1.5em;
      border-left: 4px solid var(--accent);
      color: var(--text-muted);
      font-style: italic;
    }

    .prose :global(ul),
    .prose :global(ol) {
      margin: 1.5em 0;
      padding-left: 1.75em;
    }

    .prose :global(li) {
      margin-bottom: 0.5em;
    }

    .prose :global(hr) {
      margin: 3em 0;
      border: none;
      border-top: 1px solid var(--border);
    }

    .prose :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5em 0;
      font-size: 0.9375rem;
    }

    .prose :global(th),
    .prose :global(td) {
      border: 1px solid var(--border);
      padding: 0.5rem 0.75rem;
      text-align: left;
      vertical-align: top;
    }

    .prose :global(th) {
      background: var(--bg-elev-2);
      color: var(--text);
      font-weight: 600;
    }

    .prose :global(a) {
      color: var(--accent);
    }

    /* ---------- Peta jaringan novel ---------- */

    .network-section {
      margin-bottom: 4.5rem;
    }

    .network-section .muted {
      margin-top: 0.4rem;
      max-width: 62ch;
    }

    .network-layout {
      display: grid;
      grid-template-columns: 1fr 260px;
      gap: 1.5rem;
      align-items: stretch;
      margin-top: 1.5rem;
    }

    .network-svg {
      width: 100%;
      height: auto;
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
    }

    .net-edge {
      stroke: color-mix(in srgb, var(--accent) 55%, var(--border));
      stroke-width: 1.5;
      opacity: 0.35;
      transition: opacity 200ms ease, stroke-width 200ms ease;
    }

    .net-node {
      cursor: pointer;
      outline: none;
    }

    .net-node-circle {
      fill: var(--accent);
      stroke: var(--bg);
      stroke-width: 2;
      transition: fill 200ms ease, filter 200ms ease;
    }

    .net-node-label {
      font-family: var(--font-body);
      font-size: 11px;
      fill: var(--text-muted);
      pointer-events: none;
      transition: fill 200ms ease;
    }

    .net-node:hover .net-node-circle,
    .net-node:focus-visible .net-node-circle {
      fill: var(--accent-hover);
      filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 60%, transparent));
    }

    .net-node:hover .net-node-label,
    .net-node:focus-visible .net-node-label {
      fill: var(--text);
      font-weight: 600;
    }

    .net-node.dim .net-node-circle {
      opacity: 0.25;
    }

    .net-node.dim .net-node-label {
      opacity: 0.35;
    }

    .net-edge.dim {
      opacity: 0.06;
    }

    .net-edge.hot {
      opacity: 0.9;
      stroke-width: 3;
    }

    .network-panel {
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    /* Isi panel dibuat lewat innerHTML sisi klien, jadi elemennya tidak membawa
       scope-attribute Astro — aturan harus global supaya berlaku. */
    :global(.panel-hint) {
      color: var(--text-muted);
    }

    :global(.panel-title) {
      font-family: var(--font-display);
      font-size: 1.25rem;
      color: var(--text);
      margin-bottom: 0.5rem;
    }

    :global(.panel-stats) {
      font-size: 0.8125rem;
      color: var(--text-dim);
      margin-bottom: 0.75rem;
    }

    :global(.panel-links) {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-top: 0.75rem;
    }

    :global(.panel-link) {
      display: block;
      padding: 0.5rem 0.75rem;
      background: var(--bg-elev-2);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      text-decoration: none;
      transition: border-color 200ms ease;
    }

    :global(.panel-link:hover) {
      border-color: var(--accent);
    }

    :global(.panel-link .l-title) {
      font-weight: 600;
      color: var(--text);
      font-size: 0.875rem;
    }

    :global(.panel-link .l-terms) {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.15rem;
    }

    .network-footer {
      margin-top: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .term-filter {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
    }

    .term-filter-label {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-right: 0.25rem;
    }

    .term-chip {
      padding: 0.3rem 0.8rem;
      border: 1px solid var(--border-strong);
      border-radius: 999px;
      background: var(--bg-elev);
      color: var(--text-muted);
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 200ms ease;
    }

    .term-chip:hover {
      border-color: var(--accent);
      color: var(--text);
    }

    .term-chip.active {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--accent-contrast);
      font-weight: 600;
    }

    .net-legend {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem 1.5rem;
      font-size: 0.8125rem;
      color: var(--text-muted);
    }

    .legend-item {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .legend-dot {
      width: var(--d);
      height: var(--d);
      border-radius: 50%;
      background: var(--accent);
      border: 2px solid var(--bg);
      box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
      flex-shrink: 0;
    }

    .legend-line {
      width: 2rem;
      height: 2px;
      background: color-mix(in srgb, var(--accent) 55%, var(--border));
      border-radius: 999px;
    }

    /* Filter aktif: redupkan edge/node di luar istilah terpilih.
       Hover (hot) menimpa filter supaya koneksi node tetap terlihat. */
    .net-edge.term-dim:not(.hot) {
      opacity: 0.05;
    }

    .net-node.term-dim:not(.hot) .net-node-circle {
      opacity: 0.15;
    }

    .net-node.term-dim:not(.hot) .net-node-label {
      opacity: 0.3;
    }

    @media (max-width: 900px) {
      .network-layout {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .tl-card-grid {
        grid-template-columns: 1fr;
      }

      .tl-cover {
        width: 140px;
      }

      .section-head {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    const nodes = Array.from(document.querySelectorAll<HTMLButtonElement>('.tl-node'))
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.tl-card'))

    function activate(index: number) {
      nodes.forEach((node, i) => {
        node.setAttribute('aria-pressed', String(i === index))
      })
      cards.forEach((card, i) => {
        card.classList.toggle('active', i === index)
      })
      const target = cards[index]
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
        target.focus({ preventScroll: true })
      }
    }

    nodes.forEach((node, index) => {
      node.addEventListener('click', () => activate(index))
    })

    // Keep the active card in sync with the reader's position.
    if ('IntersectionObserver' in window && cards.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const i = Number((entry.target as HTMLElement).dataset.index)
              if (!Number.isNaN(i)) activate(i)
            }
          }
        },
        { rootMargin: '-35% 0px -55% 0px' },
      )
      cards.forEach((card) => observer.observe(card))
    }

    // ---------- Peta jaringan novel ----------
    const netNodes = Array.from(document.querySelectorAll<SVGGElement>('.net-node'))
    const netEdges = Array.from(document.querySelectorAll<SVGLineElement>('.net-edge'))
    const netPanel = document.getElementById('network-panel')

    if (netNodes.length > 0 && netPanel) {
      // indeks edge per novel untuk highlight cepat
      const edgeIndex = new Map<string, SVGLineElement[]>()
      netEdges.forEach((edge) => {
        for (const slug of [edge.dataset.a, edge.dataset.b]) {
          if (!slug) continue
          const list = edgeIndex.get(slug) ?? []
          list.push(edge)
          edgeIndex.set(slug, list)
        }
      })

      function clearNetwork() {
        netNodes.forEach((n) => n.classList.remove('dim', 'hot'))
        netEdges.forEach((e) => e.classList.remove('dim', 'hot'))
      }

      function highlightNode(slug: string) {
        clearNetwork()
        const related = new Set<string>([slug])
        edgeIndex.get(slug)?.forEach((edge) => {
          edge.classList.add('hot')
          related.add(edge.dataset.a!)
          related.add(edge.dataset.b!)
        })
        netNodes.forEach((node) => {
          if (!related.has(node.dataset.slug!)) node.classList.add('dim')
          else if (node.dataset.slug !== slug) node.classList.add('hot')
        })
        return related
      }

      // Arrow function (bukan function declaration) agar narrowing `netPanel`
      // dari guard di atas ikut berlaku di dalam closure.
      const renderPanel = (slug: string) => {
        const node = netNodes.find((n) => n.dataset.slug === slug)
        const title = node?.querySelector('.net-node-label')?.textContent?.trim() ?? slug
        const degree = edgeIndex.get(slug)?.length ?? 0
        const links = edgeIndex
          .get(slug)!
          .map((edge) => {
            const other = edge.dataset.a === slug ? edge.dataset.b! : edge.dataset.a!
            const otherTitle =
              netNodes.find((n) => n.dataset.slug === other)
                ?.querySelector('.net-node-label')
                ?.textContent?.trim() ?? other
            const terms = edge.dataset.terms ?? ''
            return `<a class="panel-link" href="/novel/${other}">
              <div class="l-title">${otherTitle}</div>
              <div class="l-terms">${terms}</div>
            </a>`
          })
          .join('')
        netPanel.innerHTML = `<div class="panel-title">${title}</div>
          <div class="panel-stats">${degree} ${degree === 1 ? 'koneksi' : 'koneksi'} · klik untuk membuka novel</div>
          <div class="panel-links">${links}</div>`
      }

      // ---------- Filter istilah ----------
      const termChips = Array.from(document.querySelectorAll<HTMLButtonElement>('.term-chip'))
      let activeTerm: string | null = null

      function applyTermFilter() {
        netEdges.forEach((edge) => {
          const terms = (edge.dataset.terms ?? '').split(',').map((s) => s.trim())
          const match = !activeTerm || terms.includes(activeTerm)
          edge.classList.toggle('term-dim', !match)
        })
        netNodes.forEach((node) => {
          const slug = node.dataset.slug!
          const hasActiveEdge =
            !activeTerm ||
            netEdges.some(
              (e) =>
                !e.classList.contains('term-dim') &&
                (e.dataset.a === slug || e.dataset.b === slug),
            )
          node.classList.toggle('term-dim', !hasActiveEdge)
        })
        termChips.forEach((chip) => {
          const isActive = chip.dataset.term === (activeTerm ?? 'all')
          chip.classList.toggle('active', isActive)
          chip.setAttribute('aria-pressed', String(isActive))
        })
      }

      termChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const term = chip.dataset.term!
          activeTerm = term === 'all' ? null : term
          applyTermFilter()
        })
      })

      const resetPanel = () => {
        clearNetwork()
        applyTermFilter()
        netPanel.innerHTML =
          '<p class="panel-hint" id="network-panel-default">Arahkan kursor (atau fokus) ke sebuah novel untuk melihat istilah yang dibaginya dengan novel lain.</p>'
      }

      // State awal: filter "Semua" aktif secara eksplisit.
      applyTermFilter()

      netNodes.forEach((node) => {
        const slug = node.dataset.slug!
        node.addEventListener('mouseenter', () => {
          highlightNode(slug)
          renderPanel(slug)
        })
        node.addEventListener('focus', () => {
          highlightNode(slug)
          renderPanel(slug)
        })
        node.addEventListener('click', () => {
          window.location.href = `/novel/${slug}`
        })
        node.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault()
            window.location.href = `/novel/${slug}`
          }
        })
      })

      // Keluar dari area peta → kembalikan tampilan default.
      const svg = document.getElementById('network-svg')
      svg?.addEventListener('mouseleave', resetPanel)
    }
  </script>
</BaseLayout>
