---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getNovels, buildNovelIndex } from '../lib/novels'

const novels = await getNovels()
const novelIndex = buildNovelIndex(novels)
// Dikirim ke klien via tag JSON — lihat komentar di BookmarkButton.
const pageData = JSON.stringify(novelIndex).replace(/</g, '\\u003c')
---

<BaseLayout title="Buku Saya" description="Bookmark dan riwayat baca Anda di Kidung">
  <div class="container">
    <header class="page-head">
      <h1>Buku Saya</h1>
      <p class="muted" id="greeting"></p>
    </header>

    <!-- Belum login -->
    <div id="logged-out" hidden>
      <p class="muted">
        Masuk dengan Google untuk menyimpan bookmark dan riwayat baca — sinkron di semua
        perangkat.
      </p>
      <button id="login-btn" class="btn btn-primary login-cta">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
        </svg>
        Masuk dengan Google
      </button>
    </div>

    <!-- Sudah login -->
    <div id="logged-in" hidden>
      <section id="history-section" class="book-section" hidden>
        <h2>Lanjutkan Membaca</h2>
        <ul id="history-list" class="book-list"></ul>
      </section>

      <section id="bookmarks-section" class="book-section" hidden>
        <h2>Bookmark</h2>
        <ul id="bookmarks-list" class="book-list"></ul>
      </section>

      <p id="empty-state" class="muted empty-state" hidden>
        Belum ada bookmark atau riwayat baca. Mulai dari halaman{' '}
        <a href="/" class="accent-link">beranda</a>!
      </p>
    </div>
  </div>

  <style>
    .page-head {
      margin-bottom: 2.5rem;
    }

    .page-head h1 {
      font-size: clamp(2rem, 4vw, 2.75rem);
      margin-bottom: 0.5rem;
    }

    .login-cta {
      margin-top: 1.25rem;
    }

    .book-section {
      margin-top: 2.5rem;
    }

    .book-section h2 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }

    .book-list {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .book-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 1rem;
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      transition: border-color 200ms ease;
    }

    .book-row:hover {
      border-color: var(--accent);
    }

    .book-link {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      flex: 1;
      min-width: 0;
      text-decoration: none;
      color: inherit;
    }

    .row-cover {
      width: 40px;
      height: 60px;
      object-fit: cover;
      border-radius: 6px;
      background: var(--bg-elev-2);
      flex-shrink: 0;
    }

    .row-main {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
    }

    .row-novel {
      font-weight: 600;
      color: var(--text);
    }

    .row-chapter {
      font-size: 0.875rem;
      color: var(--text-muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .row-when {
      font-size: 0.8125rem;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .bookmark-remove {
      width: 34px;
      height: 34px;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: transparent;
      color: var(--text-dim);
      cursor: pointer;
      font-size: 1.25rem;
      line-height: 1;
      flex-shrink: 0;
      transition: all 200ms ease;
    }

    .bookmark-remove:hover {
      color: var(--accent);
      border-color: var(--accent);
    }

    .empty-state {
      margin-top: 2rem;
    }

    .accent-link {
      color: var(--accent);
      font-weight: 600;
    }

    .accent-link:hover {
      text-decoration: underline;
    }
  </style>

  <script is:inline type="application/json" id="page-data" set:html={pageData}></script>

  <script>
    import { getSupabase } from '../lib/supabase'
    import type { NovelIndexEntry } from '../lib/novels'

    const novelIndex = JSON.parse(
      document.getElementById('page-data')!.textContent || '{}',
    ) as Record<string, NovelIndexEntry>

    function esc(s: string): string {
      return s.replace(/[&<>"']/g, (c) => {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!
      })
    }

    async function init() {
      const loggedOut = document.getElementById('logged-out') as HTMLElement
      const loggedIn = document.getElementById('logged-in') as HTMLElement
      const greeting = document.getElementById('greeting') as HTMLElement
      const loginBtn = document.getElementById('login-btn') as HTMLButtonElement
      const historySection = document.getElementById('history-section') as HTMLElement
      const historyList = document.getElementById('history-list') as HTMLElement
      const bookmarksSection = document.getElementById('bookmarks-section') as HTMLElement
      const bookmarksList = document.getElementById('bookmarks-list') as HTMLElement
      const emptyState = document.getElementById('empty-state') as HTMLElement

      const supabase = getSupabase()

      if (!supabase) {
        greeting.textContent = 'Fitur akun belum aktif di situs ini.'
        return
      }

      loginBtn.addEventListener('click', () => {
        const redirectTo =
          window.location.origin + '/auth/callback?next=' + encodeURIComponent('/buku-saya')
        supabase.auth.signInWithOAuth({ provider: 'google', options: { redirectTo } })
      })

      const { data } = await supabase.auth.getSession()
      const user = data.session?.user

      if (!user) {
        loggedOut.hidden = false
        return
      }

      loggedIn.hidden = false
      greeting.textContent =
        'Halo, ' +
        (user.user_metadata?.full_name || user.email?.split('@')[0] || 'pembaca') +
        '!'

      const [{ data: history }, { data: bookmarks }] = await Promise.all([
        supabase.from('reading_history').select('*').order('updated_at', { ascending: false }),
        supabase.from('bookmarks').select('*').order('created_at', { ascending: false }),
      ])

      // --- Riwayat baca ---
      if (history?.length) {
        historySection.hidden = false
        historyList.innerHTML = history
          .map((h) => {
            const novel = novelIndex[h.novel_slug]
            if (!novel) return ''
            const chapter = novel.chapters.find((c) => c.slug === h.chapter_slug)
            if (!chapter) return ''
            const cover = novel.cover
              ? `<img class="row-cover" src="${novel.cover}" alt="" loading="lazy" />`
              : '<div class="row-cover"></div>'
            const when = new Date(h.updated_at).toLocaleDateString('id-ID', {
              day: 'numeric',
              month: 'short',
            })
            return `
              <li class="book-row">
                <a class="book-link" href="/chapter/${esc(h.novel_slug)}/${esc(h.chapter_slug)}">
                  ${cover}
                  <span class="row-main">
                    <span class="row-novel">${esc(novel.title)}</span>
                    <span class="row-chapter">Bab ${chapter.number} · ${esc(chapter.title)}</span>
                  </span>
                </a>
                <span class="row-when dim">${when}</span>
              </li>`
          })
          .join('')
      }

      // --- Bookmark ---
      if (bookmarks?.length) {
        bookmarksSection.hidden = false
        bookmarksList.innerHTML = bookmarks
          .map((b) => {
            const novel = novelIndex[b.novel_slug]
            if (!novel) return ''
            const cover = novel.cover
              ? `<img class="row-cover" src="${novel.cover}" alt="" loading="lazy" />`
              : '<div class="row-cover"></div>'
            const isChapter = Boolean(b.chapter_slug)
            const chapter = isChapter
              ? novel.chapters.find((c) => c.slug === b.chapter_slug)
              : null
            const href = isChapter
              ? `/chapter/${esc(b.novel_slug)}/${esc(b.chapter_slug)}`
              : `/novel/${esc(b.novel_slug)}`
            const sub = isChapter
              ? chapter
                ? `Bab ${chapter.number} · ${esc(chapter.title)}`
                : 'Bab'
              : 'Seluruh novel'
            return `
              <li class="book-row" data-bookmark-id="${b.id}">
                <a class="book-link" href="${href}">
                  ${cover}
                  <span class="row-main">
                    <span class="row-novel">${esc(novel.title)}</span>
                    <span class="row-chapter">${sub}</span>
                  </span>
                </a>
                <button class="bookmark-remove" data-id="${b.id}" aria-label="Hapus bookmark" title="Hapus bookmark">×</button>
              </li>`
          })
          .join('')

        bookmarksList.addEventListener('click', async (e) => {
          const target = (e.target as HTMLElement).closest('button[data-id]') as HTMLButtonElement | null
          if (!target) return
          const id = target.dataset.id
          if (!id) return
          await supabase.from('bookmarks').delete().eq('id', id)
          target.closest('li')?.remove()
          if (!bookmarksList.querySelector('li')) {
            bookmarksSection.hidden = true
          }
          updateEmpty()
        })
      }

      function updateEmpty() {
        emptyState.hidden = historySection.hidden === false || bookmarksSection.hidden === false
      }
      updateEmpty()
    }

    init()
  </script>
</BaseLayout>
