---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kidung � Rumah Cerita & Novel' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, system-ui, sans-serif;
    background: #07080b;
    color: #f8fafc;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    min-height: 100%;
    background: radial-gradient(circle at top left, rgba(16, 163, 127, 0.08), transparent 20%),
      radial-gradient(circle at bottom right, rgba(168, 103, 255, 0.06), transparent 24%),
      #07080b;
    color: #f8fafc;
  }

  body {
    line-height: 1.7;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .page {
    width: min(100%, 1200px);
    margin: 0 auto;
    padding: 0 20px 28px;
  }

  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 20px 0;
    margin-bottom: 8px;
  }

  .brand {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .brand-subtitle {
    font-size: 0.95rem;
    font-weight: 500;
    color: #9ca3af;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* ---- Hero (Gooddreamer-style) ---- */
  .hero {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    padding: 48px 40px;
    margin: 8px 0 32px;
    background:
      radial-gradient(circle at 85% 20%, rgba(16, 163, 127, 0.35), transparent 45%),
      radial-gradient(circle at 10% 90%, rgba(168, 103, 255, 0.3), transparent 45%),
      linear-gradient(135deg, #0d1b2a 0%, #1b263b 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-inner {
    max-width: 640px;
  }

  .hero-label {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(16, 163, 127, 0.15);
    color: #34d399;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .hero-title {
    margin: 0 0 16px;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero-text {
    margin: 0 0 28px;
    color: #cbd5e1;
    font-size: 1.1rem;
    max-width: 560px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---- Novel grid (Webnovel-style) ---- */
  .novel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }

  .novel-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
    border: 1px solid #22252a;
    border-radius: 18px;
    background: rgba(17, 21, 28, 0.95);
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .novel-card:hover {
    transform: translateY(-3px);
    border-color: #10a37f;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .novel-cover {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(160deg, #1f2937, #11151c);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .novel-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .novel-cover-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 100%;
    padding: 16px;
    text-align: center;
    color: #9ca3af;
    font-size: 0.9rem;
  }

  .novel-cover-placeholder .cover-glyph {
    font-size: 2.4rem;
    opacity: 0.5;
  }

  .novel-card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .novel-card-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .novel-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 0.85rem;
    color: #9ca3af;
  }

  .novel-card-desc {
    margin: 0;
    color: #cbd5e1;
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(16, 163, 127, 0.12);
    color: #34d399;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: #11151c;
    color: #f8fafc;
    transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }

  .button:hover {
    transform: translateY(-1px);
    background: #1f2937;
  }

  .button-primary {
    background: #10a37f;
    color: #040814;
  }

  .button-primary:hover {
    background: #14b38e;
  }

  .button-ghost {
    background: transparent;
    border-color: #22252a;
  }

  .button-ghost:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .hero {
    padding: 16px 0 22px;
    max-width: 680px;
  }

  .hero-label,
  .meta,
  .section-text,
  .footer-note {
    color: #9ca3af;
  }

  .hero-title,
  .section-title,
  .article-title {
    margin: 0;
    line-height: 1.1;
  }

  .hero-title {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
  }

  .section-title {
    font-size: 1.9rem;
  }

  .article-title {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .section {
    padding: 28px 0;
  }

  .section-grid,
  .cards,
  .chapter-list {
    display: grid;
    gap: 14px;
  }

  .section-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card,
  .chapter-link,
  .nav-card {
    padding: 18px;
    border: 1px solid #22252a;
    border-radius: 18px;
    background: rgba(17, 21, 28, 0.95);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .card:hover,
  .chapter-link:hover,
  .nav-card:hover {
    transform: translateY(-1px);
    border-color: #10a37f;
  }

  .card-title {
    margin: 0 0 8px;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .card-text {
    margin: 0;
    color: #cbd5e1;
  }

  /* ---- Novel detail page (Webnovel-style) ---- */
  .novel-detail {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    align-items: start;
    padding: 32px 0;
  }

  .novel-detail-cover {
    position: sticky;
    top: 24px;
    aspect-ratio: 3 / 4;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(160deg, #1f2937, #11151c);
    border: 1px solid #22252a;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .novel-detail-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .novel-detail-cover .novel-cover-placeholder {
    font-size: 1rem;
  }

  .novel-detail-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .novel-detail-title {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .novel-detail-desc {
    margin: 0;
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .novel-detail-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .stat {
    padding: 8px 14px;
    border-radius: 12px;
    background: #11151c;
    border: 1px solid #22252a;
    font-size: 0.9rem;
    color: #cbd5e1;
  }

  .stat strong {
    color: #f8fafc;
  }

  .novel-detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .width-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin: 20px 0 12px;
    font-size: 0.95rem;
    color: #cbd5e1;
  }

  .width-controls button {
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid #22252a;
    background: #11151c;
    color: #f8fafc;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease;
  }

  .width-controls button:hover,
  .width-controls button.active {
    border-color: #10a37f;
    background: #111f26;
  }

  .article-content {
    margin-top: 18px;
    width: min(100%, 100rem);
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
  }

  .article-content[data-width='narrow'] {
    max-width: 680px;
  }

  .article-content[data-width='medium'] {
    max-width: 840px;
  }

  .article-content[data-width='wide'] {
    max-width: 1080px;
  }

  .bookmark-banner,
  .history-banner,
  .novel-history {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 999px;
    background: #11151c;
    color: #cbd5e1;
    font-size: 0.92rem;
    margin-top: 16px;
  }

  .novel-history {
    display: block;
    width: 100%;
    padding: 14px 18px;
    border-radius: 18px;
    background: rgba(17, 21, 28, 0.95);
    border: 1px solid #11151c;
    margin-top: 20px;
  }

  .section-bookmark-button {
    opacity: 0;
    margin-left: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: rgba(16, 163, 127, 0.12);
    color: #10a37f;
    font-size: 0.85rem;
    cursor: pointer;
    transition: opacity 0.18s ease, background 0.18s ease;
  }

  .section-bookmark-button:hover {
    background: rgba(16, 163, 127, 0.2);
  }

  .article-content h1:hover .section-bookmark-button,
  .article-content h2:hover .section-bookmark-button,
  .article-content h3:hover .section-bookmark-button,
  .article-content h4:hover .section-bookmark-button {
    opacity: 1;
  }

  .chapter-floater {
    position: sticky;
    top: 18px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 18px;
    margin-bottom: 14px;
    border-radius: 18px;
    background: rgba(7, 8, 11, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .chapter-floating-title {
    flex: 1;
    text-align: center;
    font-size: 1rem;
    font-weight: 500;
    color: #f8fafc;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chapter-floater .button {
    padding: 8px 16px;
  }

  .article {
    padding: 20px 0;
  }

  .article-content {
    margin-top: 24px;
  }

  .article-content h1,
  .article-content h2,
  .article-content h3 {
    color: #f8fafc;
    margin-top: 1.8rem;
    margin-bottom: 0.8rem;
  }

  .article-content p,
  .article-content li {
    margin-bottom: 1rem;
    color: #d1d5db;
  }

  .article-content a {
    color: #10a37f;
  }

  .article-content ul,
  .article-content ol {
    padding-left: 1.25rem;
  }

  .chapter-nav-inner {
    display: flex;
    justify-content: space-between;
    gap: 14px;
  }

  .chapter-nav .nav-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px;
    border: 1px solid #22252a;
    border-radius: 18px;
    background: rgba(17, 21, 28, 0.95);
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .chapter-nav .nav-card:hover {
    transform: translateY(-1px);
    border-color: #10a37f;
  }

  .chapter-nav .nav-label {
    font-size: 0.85rem;
    color: #9ca3af;
  }

  .chapter-nav .nav-title {
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .footer {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid #22252a;
    text-align: center;
    font-size: 0.95rem;
    color: #9ca3af;
  }

  @media (max-width: 760px) {
    .section-grid {
      grid-template-columns: 1fr;
    }

    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero {
      padding: 32px 24px;
    }

    .novel-detail {
      grid-template-columns: 1fr;
    }

    .novel-detail-cover {
      position: static;
      max-width: 220px;
    }
  }
</style>
