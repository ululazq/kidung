---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const { title = 'Kidung', description = 'Koleksi novel dark fantasy dan urban fantasy' } = Astro.props

const fullTitle = title === 'Kidung' ? title : `${title} · Kidung`
---

<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@400;500;600&family=Literata:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>

    <!-- Runs before first paint: without it the dark default flashes
         for light-mode readers on every navigation. -->
    <script is:inline>
      ;(function () {
        try {
          var stored = localStorage.getItem('theme')
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark'
          document.documentElement.setAttribute('data-theme', theme)

          var size = localStorage.getItem('reader-size')
          if (size) document.documentElement.style.setProperty('--reader-size', size + 'px')
        } catch (e) {}
      })()
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <nav aria-label="Main navigation">
      <div class="container nav-inner">
        <a href="/" class="logo">Kidung</a>

        <div class="nav-actions">
          <button
            id="theme-toggle"
            class="icon-btn"
            aria-label="Toggle dark/light theme"
            title="Toggle theme"
          >
            <svg
              class="sun-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="10" cy="10" r="4"></circle>
              <path d="M10 1v2m0 14v2M3.93 3.93l1.41 1.41m9.9 9.9l1.41 1.41M1 10h2m14 0h2M3.93 16.07l1.41-1.41m9.9-9.9l1.41-1.41"></path>
            </svg>
            <svg
              class="moon-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
            </svg>
          </button>

          <!-- Auth area: diisi script — skeleton saat status dicek, lalu
               pill "Masuk" (placeholder) atau menu user. -->
          <div id="auth-area" class="auth-area">
            <div id="auth-skeleton" class="auth-profile auth-skeleton" aria-hidden="true">
              <span class="auth-avatar"></span>
              <span class="skeleton-name"></span>
            </div>
            <button id="auth-login" class="auth-profile auth-login-pill" hidden>
              <span class="auth-avatar">
                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                  <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                  <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                  <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                  <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
              </span>
              <span class="auth-name">Masuk</span>
            </button>
            <div id="auth-user" class="auth-user" hidden>
              <a href="/buku-saya" class="auth-profile" title="Buku Saya">
                <span id="auth-avatar" class="auth-avatar">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                  </svg>
                </span>
                <span id="auth-name" class="auth-name"></span>
              </a>
              <button id="auth-logout" class="icon-btn auth-logout" aria-label="Keluar" title="Keluar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                  <polyline points="16 17 21 12 16 7" />
                  <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
              </button>
            </div>
          </div>

          <a href="/universe" class="btn">Universe</a>
          <a href="/tentang" class="btn">Tentang</a>
        </div>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="container footer-inner">
        <p class="muted">
          Kidung — Rumah cerita, rumah novel, rumah imajinasi
        </p>
        <p class="dim" style="font-size: 0.875rem; margin-top: 0.5rem;">
          © {new Date().getFullYear()} · Dibuat dengan
          <a href="https://astro.build" target="_blank" rel="noopener" style="color: var(--accent)">Astro</a>
        </p>
      </div>
    </footer>

    <style>
      nav {
        position: sticky;
        top: 0;
        z-index: var(--z-nav);
        background: color-mix(in srgb, var(--bg) 90%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 4rem;
        gap: 1rem;
      }

      .logo {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--accent);
        text-decoration: none;
        transition: opacity 200ms ease;
      }

      .logo:hover {
        opacity: 0.8;
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .auth-area {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /* Pill login = placeholder area user saat belum login. Dipakai
         sebagai tombol (klik → login Google) maupun tampilan saat login. */
      .auth-login-pill {
        background: transparent;
        font: inherit;
        color: inherit;
        cursor: pointer;
        white-space: nowrap;
      }

      .auth-avatar svg {
        width: 18px;
        height: 18px;
      }

      /* Skeleton: placeholder selama status login belum diketahui
         (getSession masih jalan) — mencegah area auth kosong & layout shift. */
      .auth-skeleton {
        pointer-events: none;
      }

      .auth-skeleton .skeleton-name {
        width: 5.5rem;
        height: 0.75rem;
        border-radius: 999px;
        background: var(--bg-elev-2);
      }

      .auth-skeleton .auth-avatar,
      .auth-skeleton .skeleton-name {
        animation: auth-skeleton-pulse 1.4s ease-in-out infinite;
      }

      @keyframes auth-skeleton-pulse {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.45;
        }
      }

      .auth-user {
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }

      .auth-profile {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.25rem 0.65rem 0.25rem 0.3rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        transition: border-color 200ms ease;
      }

      .auth-profile:hover {
        border-color: var(--accent);
      }

      .auth-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--bg-elev-2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--accent);
        flex-shrink: 0;
      }

      /* Avatar diisi lewat innerHTML sisi klien, jadi elemennya tidak membawa
         scope-attribute Astro — aturan harus global supaya berlaku. */
      :global(.auth-avatar img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .auth-name {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text);
        max-width: 9rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .auth-logout {
        width: 38px;
        height: 38px;
      }

      .sun-icon {
        display: none;
      }

      .moon-icon {
        display: block;
      }

      :global([data-theme='light']) .sun-icon {
        display: block;
      }

      :global([data-theme='light']) .moon-icon {
        display: none;
      }

      main {
        min-height: calc(100vh - 15rem);
        padding-block: 3rem;
      }

      footer {
        border-top: 1px solid var(--border);
        padding-block: 2.5rem;
        margin-top: 4rem;
      }

      .footer-inner {
        text-align: center;
      }

      @media (max-width: 640px) {
        .logo {
          font-size: 1.25rem;
        }

        .nav-actions .btn {
          display: none;
        }

        /* Pill login tetap tampil walau nav lain disembunyikan, dan teksnya
           ikut tampil (tidak hanya logo G) supaya tetap jelas bisa diklik. */
        .auth-login-pill .auth-name {
          display: inline;
        }

        .auth-login-pill {
          min-height: 44px;
        }

        .auth-name {
          display: none;
        }

        .auth-logout {
          width: 44px;
          height: 44px;
        }
      }
    </style>

    <script>
      // Theme toggle — persisted to localStorage
      const toggle = document.getElementById('theme-toggle')
      const html = document.documentElement

      function getTheme(): 'light' | 'dark' {
        const stored = localStorage.getItem('theme')
        if (stored === 'light' || stored === 'dark') return stored
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'
      }

      function setTheme(theme: 'light' | 'dark') {
        html.setAttribute('data-theme', theme)
        localStorage.setItem('theme', theme)
      }

      // Apply persisted theme immediately to avoid flash
      setTheme(getTheme())

      toggle?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme')
        setTheme(current === 'dark' ? 'light' : 'dark')
      })
    </script>

    <script>
      import { getSupabase } from '../lib/supabase'

      const loginBtn = document.getElementById('auth-login') as HTMLButtonElement
      const userBox = document.getElementById('auth-user') as HTMLElement
      const skeleton = document.getElementById('auth-skeleton') as HTMLElement
      const avatar = document.getElementById('auth-avatar') as HTMLElement
      const nameEl = document.getElementById('auth-name') as HTMLElement
      const logoutBtn = document.getElementById('auth-logout') as HTMLButtonElement

      const supabase = getSupabase()

      if (supabase) {
        renderAuth()

        loginBtn.addEventListener('click', () => {
          const redirectTo =
            window.location.origin +
            '/auth/callback?next=' +
            encodeURIComponent(window.location.pathname)
          supabase.auth.signInWithOAuth({ provider: 'google', options: { redirectTo } })
        })

        logoutBtn.addEventListener('click', async () => {
          await supabase.auth.signOut()
          window.location.href = '/'
        })

        supabase.auth.onAuthStateChange(() => renderAuth())
      } else {
        // Fitur akun nonaktif (env Supabase kosong): skeleton tak akan pernah
        // terisi — sembunyikan biar tidak menggantung.
        skeleton.hidden = true
      }

      async function renderAuth() {
        if (!supabase) return
        try {
          const { data } = await supabase.auth.getSession()
          const user = data.session?.user ?? null

          // Isi konten dulu, baru tampilkan — area user tidak pernah
          // tampil setengah-setengah (avatar kosong / tombol keluar tanpa login).
          if (user) {
            const displayName: string =
              user.user_metadata?.full_name || user.email?.split('@')[0] || 'Pembaca'
            nameEl.textContent = displayName

            const avatarUrl = user.user_metadata?.avatar_url as string | undefined
            if (avatarUrl) {
              avatar.innerHTML = `<img src="${avatarUrl}" alt="" referrerpolicy="no-referrer" />`
            } else {
              avatar.textContent = displayName.charAt(0).toUpperCase()
            }
          }

          loginBtn.hidden = Boolean(user)
          userBox.hidden = !user
        } finally {
          // Apa pun hasilnya (sukses/gagal), skeleton selalu ditutup.
          skeleton.hidden = true
        }
      }
    </script>
  </body>
</html>
